# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Your identity ──────────────────────────────────────────────────────────────
YOUR_NAME=Josh
YOUR_EMAIL=joshuan.sandoval@gmail.com
YOUR_SERVICE=AI automation for small businesses
YOUR_PRICE=$3,000

# ── Gmail SMTP (required for sending) ──────────────────────────────────────────
# Use an App Password — NOT your regular Gmail password.
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
#    (select "Mail" + "Other device", copy the 16-char password)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Calendly booking link (required — goes in every email CTA) ─────────────────
CALENDLY_LINK=https://calendly.com/joshuan-sandoval

# ── Outscraper (free — 100 Google Maps results/month, no card needed) ──────────
# Sign up at outscraper.com → Profile → API Key
OUTSCRAPER_API_KEY=

# ── Hunter.io (free — 25 email lookups/month) ──────────────────────────────────
# Sign up free at hunter.io → Dashboard → API → copy your key
HUNTER_API_KEY=

# ── Apollo.io (optional — needed only for `python main.py scrape`) ─────────────
# Free plan does NOT support people search.
# Use `python main.py import leads.csv` instead (free path).
# Paid plan: https://app.apollo.io/
APOLLO_API_KEY=

# ── Mailchimp (optional — bulk list management only) ───────────────────────────
# Individual emails now go via Gmail SMTP; Mailchimp is not needed to send.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER=us1
MAILCHIMP_LIST_ID=

# ── Trading Bot ────────────────────────────────────────────────────────────────
# Set PAPER_TRADING=false only when you're ready for real money.
# Start with paper trading to verify the bot behaves correctly.
PAPER_TRADING=true
MIN_PROFIT_PCT=0.003
MAX_TRADE_USDT=100
SCAN_INTERVAL=1.0
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# Binance — https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Kraken — https://www.kraken.com/u/security/api
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Coinbase Advanced Trade — https://www.coinbase.com/settings/api
COINBASE_API_KEY=
COINBASE_API_SECRET=
