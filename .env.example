# Copy this to .env and fill in your values

# Apollo.io - get from https://developer.apollo.io/keys
APOLLO_API_KEY=your_apollo_api_key

# Mailchimp - get from https://mailchimp.com/developer/ > API Keys
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_SERVER=us1          # first part of your data center, e.g. us1, us6, etc.
MAILCHIMP_LIST_ID=your_list_id

# Calendly - get from https://calendly.com/integrations/api_webhooks
CALENDLY_ACCESS_TOKEN=your_calendly_token
CALENDLY_LINK=https://calendly.com/yourname/30min

# Anthropic (for email generation)
ANTHROPIC_API_KEY=your_anthropic_key

# Your info (shows in email from/signature)
YOUR_NAME=Josh
YOUR_EMAIL=joshuan.sandoval@gmail.com
YOUR_SERVICE=AI automation for small businesses
YOUR_PRICE=$3,000
